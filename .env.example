# Chatbot Configuration
CHATBOT_MODEL=llama-2
CHATBOT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
HUGGINGFACE_API_KEY=

# Unit Rates (Namibian Dollars)
GP_UNIT_RATE=115.70
ANAESTHETIST_UNIT_RATE=115.50

# Modifier Payment Factors
MODIFIER_0036_FACTOR=0.82
MODIFIER_0023_FACTOR=1.00
MODIFIER_0038_FACTOR=1.00
MODIFIER_0039_FACTOR=1.00

# Anaesthetic Schedule
FIRST_HOUR_UNITS_PER_15MIN=2
LATER_HOURS_UNITS_PER_15MIN=3
MINIMUM_UNITS=6

# ICD-10 Model Paths
ICD_MODEL_PATH=models/icd10_model.pkl
